{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/constelaciones", "destination": "/" },
    { "source": "/tarot", "destination": "/" },
    { "source": "/meditacion", "destination": "/" },
    { "source": "/acompanamiento", "destination": "/" },
    { "source": "/contacto", "destination": "/" },
    { "source": "/aviso-legal", "destination": "/" },
    { "source": "/privacidad", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
